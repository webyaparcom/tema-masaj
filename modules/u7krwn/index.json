{
  "name": "Referans Perde — üzerine gelince alttan açılan bilgi perdesi",
  "description": "Koyu zeminde 4 sütun logo karoları; üzerine gelince ya da odakta karonun altından vurgu renkli perde kalkar: ad, sektör, yıl. Dokunmatik ekranda perde bilgisi karo altında durağan. Bilgi katmanı görselin üstüne kayar (perde/reveal): logolar sade durur, ayrıntı etkileşimle gelir; çevirmeden farklı olarak karo yerinde kalır. Metinler dil sözlüğü, renkler desing + var(--mx-site-*), mantıksal CSS → RTL. Veri yoksa blok basılmaz.",
  "version": "1.0.0",
  "icon": "vertical_align_top",
  "category": "referans",
  "subCategory": "reveal-overlay",
  "tags": [
    "referans",
    "overlay",
    "reveal",
    "dark",
    "hover",
    "rtl",
    "fabrika"
  ],
  "desing": {
    "max": "1200px",
    "bosluk": "clamp(56px, 8vw, 104px)",
    "yuvarlak": "18px",
    "ust": "",
    "baslik": "",
    "metin": "",
    "sayi": "",
    "sayiEtiket": "",
    "bg": "var(--mx-site-text, #111318)",
    "text": "var(--mx-site-bg, #ffffff)",
    "muted": "color-mix(in srgb, var(--mx-site-bg, #ffffff) 78%, var(--mx-site-text, #111318))",
    "kartBg": "color-mix(in srgb, var(--mx-site-bg, #ffffff) 7%, transparent)",
    "cizgi": "color-mix(in srgb, var(--mx-site-bg, #ffffff) 18%, transparent)",
    "accent": "color-mix(in srgb, var(--mx-site-primary, #2563eb) 55%, var(--mx-site-bg, #ffffff))",
    "accentInk": "color-mix(in srgb, var(--mx-site-primary, #2563eb) 45%, var(--mx-site-bg, #ffffff))",
    "accentText": "var(--mx-site-text, #111318)",
    "vurguBg": "color-mix(in srgb, var(--mx-site-primary, #2563eb) 55%, var(--mx-site-bg, #ffffff))",
    "vurguText": "var(--mx-site-text, #111318)",
    "bgcolor": "var(--mx-site-text, #111318)",
    "color": "var(--mx-site-bg, #ffffff)"
  },
